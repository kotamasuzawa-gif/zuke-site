# 植欲マップ 掲載情報フォームの送信先(Google Apps Script Webアプリ)
# セットアップ手順: docs/entry-form-setup.md

# Apps Script ウェブアプリのデプロイURL(未設定だとデータは保存されません)
GOOGLE_APPS_SCRIPT_URL=""

# Apps Script の SHARED_SECRET と同じ値(任意・推奨)
ENTRY_SHARED_SECRET=""

# BASE API v2 の Personal Access Token（items.read のみ）。未設定ならサイトは今までどおり
BASE_API_TOKEN=""

# 同期の段階。0=今までどおり 1=点検だけ 2=商品ページと購入中継 3=一覧・ホーム・ガイドのカードも含む
BASE_SYNC_STAGE=""

# 日次点検 /api/base-mismatch を Vercel Cron から呼ぶときの合言葉。未設定なら点検ルートは拒否する
CRON_SECRET=""
